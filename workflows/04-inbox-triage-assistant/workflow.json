          }
        ],
        [
          {
            "node": "Save Normal Email to Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Urgent Email": {
      "main": [
        [
          {
            "node": "Alert Support for Urgent Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Support for Urgent Email": {
      "main": [
        [
          {
            "node": "Return Urgent Triage Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Normal Email to Queue": {
      "main": [
        [
          {
            "node": "Return Queued Triage Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Called by Parent Workflow": {
      "main": [
        [
          {
            "node": "Normalize Parent Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Parent Payload": {
      "main": [
        [
          {
