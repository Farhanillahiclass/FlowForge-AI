{
  "name": "04 - Professional Inbox Triage",
  "nodes": [
    {
      "id": "trigger",
      "name": "Receive Email Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "inbox-triage",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "classify",
      "name": "Classify and Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json; const subject=String(b.subject||''); const text=String(b.text||b.snippet||''); const content=(subject+' '+text).toLowerCase(); const priority=/urgent|asap|blocked|outage|security|payment failed/.test(content)?'high':'normal'; const category=/invoice|payment|refund|billing/.test(content)?'billing':/bug|error|crash|not working|access/.test(content)?'technical':/meeting|schedule|calendar/.test(content)?'scheduling':'general'; return [{json:{from:String(b.from||''),subject,text,priority,category,needsHuman:true,receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "urgent",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "urgent",
      "name": "Urgent Alert — Connect Slack or Telegram",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        950,
        200
      ],
      "parameters": {}
    },
    {
      "id": "normal",
      "name": "Queue — Connect Helpdesk or Sheets",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        950,
        400
      ],
      "parameters": {}
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -500,
        520
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    }
  ],
  "connections": {
    "Receive Email Event": {
      "main": [
        [
          {
            "node": "Classify and Normalize Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify and Normalize Email": {
      "main": [
        [
          {
            "node": "High Priority?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High Priority?": {
      "main": [
        [
          {
            "node": "Urgent Alert — Connect Slack or Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Queue — Connect Helpdesk or Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Called by Parent Workflow": {
      "main": [
        [
          {
            "node": "Normalize Parent Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Parent Payload": {
      "main": [
        [
          {
            "node": "Classify and Normalize Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "ffai-04",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
