{
  "name": "04 - Professional Inbox Triage",
  "nodes": [
    {
      "id": "trigger",
      "name": "Receive Email Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "inbox-triage",
        "responseMode": "lastNode",
        "options": {},
        "authentication": "headerAuth"
      }
    },
    {
      "id": "classify",
      "name": "Classify and Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const subject=String(b.subject||'');const text=String(b.text||b.snippet||'');const email=String(b.from||b.email||'');const requestId=String(b.requestId||b.messageId||b.id||'inbox-'+Date.now());const content=(subject+' '+text).toLowerCase();const priority=/urgent|asap|blocked|outage|security|payment failed/.test(content)?'high':'normal';const category=/invoice|payment|refund|billing/.test(content)?'billing':/bug|error|crash|not working|access/.test(content)?'technical':/meeting|schedule|calendar/.test(content)?'scheduling':'general';return [{json:{requestId,from:email,subject,text,priority,category,needsHuman:true,receivedAt:new Date().toISOString(),status:priority==='high'?'urgent-review':'queued'}}];"
      }
    },
    {
      "id": "if",
      "name": "High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "urgent",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "urgent",
      "name": "Alert Support for Urgent Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        950,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_SUPPORT_EMAIL",
        "subject": "[Urgent inbox] {{ $('Classify and Normalize Email').first().json.subject }}",
        "emailType": "text",
        "message": "=Urgent inbound email needs review.\\nRequest ID: {{ $('Classify and Normalize Email').first().json.requestId }}\\nFrom: {{ $('Classify and Normalize Email').first().json.from }}\\nSubject: {{ $('Classify and Normalize Email').first().json.subject }}\\nCategory: {{ $('Classify and Normalize Email').first().json.category }}\\n\\n{{ $('Classify and Normalize Email').first().json.text }}",
        "options": {}
      }
    },
    {
      "id": "normal",
      "name": "Save Normal Email to Queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        950,
        400
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_INBOX_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "InboxQueue",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "requestId": "={{ $('Classify and Normalize Email').first().json.requestId }}",
            "from": "={{ $('Classify and Normalize Email').first().json.from }}",
            "subject": "={{ $('Classify and Normalize Email').first().json.subject }}",
            "text": "={{ $('Classify and Normalize Email').first().json.text }}",
            "priority": "={{ $('Classify and Normalize Email').first().json.priority }}",
            "category": "={{ $('Classify and Normalize Email').first().json.category }}",
            "status": "queued",
            "receivedAt": "={{ $('Classify and Normalize Email').first().json.receivedAt }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -500,
        520
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    },
    {
      "id": "urgent-log",
      "name": "Log Urgent Email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        950,
        100
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_INBOX_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "InboxQueue",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "requestId": "={{ $('Classify and Normalize Email').first().json.requestId }}",
            "from": "={{ $('Classify and Normalize Email').first().json.from }}",
            "subject": "={{ $('Classify and Normalize Email').first().json.subject }}",
            "text": "={{ $('Classify and Normalize Email').first().json.text }}",
            "priority": "={{ $('Classify and Normalize Email').first().json.priority }}",
            "category": "={{ $('Classify and Normalize Email').first().json.category }}",
            "status": "urgent-review",
            "receivedAt": "={{ $('Classify and Normalize Email').first().json.receivedAt }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "urgent-result",
      "name": "Return Urgent Triage Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        100
      ],
      "parameters": {
        "jsCode": "const e=$('Classify and Normalize Email').first().json;return [{json:{ok:true,status:'urgent-review',httpStatus:202,requestId:e.requestId,priority:e.priority,category:e.category,alertAttempted:true}}];"
      }
    },
    {
      "id": "normal-result",
      "name": "Return Queued Triage Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        400
      ],
      "parameters": {
        "jsCode": "const e=$('Classify and Normalize Email').first().json;return [{json:{ok:true,status:'queued',httpStatus:202,requestId:e.requestId,priority:e.priority,category:e.category,alertAttempted:false}}];"
      }
    }
  ],
  "connections": {
    "Receive Email Event": {
      "main": [
        [
          {
            "node": "Classify and Normalize Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify and Normalize Email": {
      "main": [
        [
          {
            "node": "High Priority?",
            "type": "main",
            "index": 0
          }
        ]
