{
  "name": "YouTube Publish Checklist",
  "nodes": [
    {
      "id": "trigger-9",
      "name": "Receive request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "youtube-publish-checklist",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "process-9",
      "name": "Validate and prepare data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const title=String(b.title||\"\").trim();const description=String(b.description||\"\").trim();const videoUrl=String(b.videoUrl||\"\").trim();const tags=Array.isArray(b.tags)?b.tags:[];const checks={title:title.length>0&&title.length<=100,description:description.length>0,videoUrl:/^https?:\\/\\//i.test(videoUrl)};return [{json:{title,description,videoUrl,tags:tags.join(\", \"),checks,ready:Object.values(checks).every(Boolean),status:\"review_required\",createdAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "sheets-9",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        300
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "slack-9",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        970,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "YOUR_SLACK_CHANNEL_ID",
        "text": "={{ $json.slackText || $json.alert || JSON.stringify($json) }}",
        "otherOptions": {}
      }
    }
  ],
  "connections": {
    "Receive request": {
      "main": [
        [
          {
            "node": "Validate and prepare data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate and prepare data": {
      "main": [
        [
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Google Sheets": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-9",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
