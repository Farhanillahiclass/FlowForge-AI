{
  "name": "12 - Instagram Publishing Pipeline",
  "nodes": [
    {
      "id": "trigger",
      "name": "Receive Instagram Draft",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "instagram-publish-request",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate Caption and Public Media URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const caption=String(b.caption||'').trim();const imageUrl=String(b.imageUrl||'').trim();const valid=!!caption&&/^https:\\/\\//i.test(imageUrl);return [{json:{caption,imageUrl,valid,approvalRequired:true,status:valid?'pending-approval':'invalid-input',submittedAt:new Date().toISOString(),note:'Publishing requires eligible Instagram professional account and Meta API permissions.'}}];"
      }
    },
    {
      "id": "if",
      "name": "Draft Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "publish",
      "name": "Human Approval → Meta Media Container → Publish → Poll Status",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        200
      ],
      "parameters": {}
    },
    {
      "id": "bad",
      "name": "Return Invalid Draft",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        960,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\":false,\"message\":\"Caption and public HTTPS media URL required\"}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Receive Instagram Draft": {
      "main": [
        [
          {
            "node": "Validate Caption and Public Media URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Caption and Public Media URL": {
      "main": [
        [
          {
            "node": "Draft Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Valid?": {
      "main": [
        [
          {
            "node": "Human Approval → Meta Media Container → Publish → Poll Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Invalid Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-12-instagram-publishing-pipeline",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
