          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "requestId": "={{ $('Parse Commands').item.json.requestId }}",
            "name": "={{ $('Parse Commands').item.json.leadName }}",
            "email": "={{ $('Parse Commands').item.json.leadEmail }}",
            "company": "={{ $('Parse Commands').item.json.company }}",
            "source": "telegram",
            "status": "new",
            "receivedAt": "={{ $('Parse Commands').item.json.receivedAt }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
