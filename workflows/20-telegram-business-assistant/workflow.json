        "subject": "New Telegram support request",
        "emailType": "text",
        "message": "=Request ID: {{ $('Parse Commands').item.json.requestId }}\\nChat ID: {{ $('Parse Commands').item.json.chatId }}\\nMessage: {{ $('Parse Commands').item.json.supportText || $('Parse Commands').item.json.text }}",
        "options": {}
      }
    },
    {
      "id": "support-reply",
