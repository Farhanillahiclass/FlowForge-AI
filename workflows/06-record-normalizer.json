{
  "name": "06 — CRM Contact Normalizer",
  "nodes": [
    {
      "id": "manual",
      "name": "Run workflow manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {}
    },
    {
      "id": "process",
      "name": "Validate and process input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item)=>{const r=item.json;const email=String(r.email||\"\").trim().toLowerCase();const name=String(r.name||[r.firstName,r.lastName].filter(Boolean).join(\" \")).replace(/\\s+/g,\" \").trim();const phone=String(r.phone||\"\").trim();const issues=[];if(!name)issues.push(\"missing_name\");if(email&&!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))issues.push(\"invalid_email\");return {json:{...r,name,email,phone,valid:issues.length===0,validationIssues:issues,normalizedAt:new Date().toISOString()}}});"
      }
    }
  ],
  "connections": {
    "Run workflow manually": {
      "main": [
        [
          {
            "node": "Validate and process input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-6",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
