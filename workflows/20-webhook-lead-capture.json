{
  "name": "20 — Website Lead Capture and Validation",
  "nodes": [
    {
      "id": "webhook",
      "name": "Receive website lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "website-lead-capture",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "process",
      "name": "Validate and normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $json.body || $json;\nconst name = String(b.name || '').trim();\nconst email = String(b.email || '').trim().toLowerCase();\nconst validEmail = /^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(email);\nreturn [{json:{name,email,company:String(b.company||''),source:String(b.source||'website'),message:String(b.message||''),validEmail,status:'new',receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Email valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "email-valid",
              "leftValue": "={{ $json.validEmail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sheets",
      "name": "Save lead to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1000,
        220
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "gmail",
      "name": "Send customer acknowledgement",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1260,
        220
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "Thanks for contacting us",
        "emailType": "text",
        "message": "=Hi {{ $json.name || 'there' }},\n\nThanks for contacting us. We received your inquiry and will follow up soon.\n\nRegards,\nCustomer Success",
        "options": {}
      }
    },
    {
      "id": "ok",
      "name": "Return success response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1510,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"message\":\"Lead received\"}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "bad",
      "name": "Return validation error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1000,
        430
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":false,\"message\":\"A valid email is required\"}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Receive website lead": {
      "main": [
        [
          {
            "node": "Validate and normalize lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate and normalize lead": {
      "main": [
        [
          {
            "node": "Email valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email valid?": {
      "main": [
        [
          {
            "node": "Save lead to Google Sheets",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return validation error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save lead to Google Sheets": {
      "main": [
        [
          {
            "node": "Send customer acknowledgement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send customer acknowledgement": {
      "main": [
        [
          {
            "node": "Return success response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-20",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
