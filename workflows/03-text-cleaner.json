        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item)=>{const d=item.json;const raw=String(d.text??d.message??\"\");const cleaned=raw.replace(/\\s+/g,\" \").trim();return {json:{...d,originalLength:raw.length,cleanedText:cleaned,cleanedLength:cleaned.length,wordCount:cleaned?cleaned.split(\" \").length:0,wasChanged:raw!==cleaned}}});"
      }
    }
  ],
