      ],
      "parameters": {}
    },
    {
      "id": "process",
      "name": "Validate and process input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(i=>{const r=i.json;const due=Date.parse(r.dueDate||r.deadline||\"\");const valid=Number.isFinite(due);const remaining=valid?Math.ceil((due-Date.now())/86400000):null;const status=!valid?\"invalid-date\":remaining<0?\"overdue\":remaining===0?\"due-today\":remaining<=2?\"due-soon\":\"on-track\";return {json:{...r,validDueDate:valid,daysRemaining:remaining,status,requiresAttention:[\"overdue\",\"due-today\",\"due-soon\"].includes(status),checkedAt:new Date().toISOString()}}});"
      }
    }
  ],
  "connections": {
    "Run workflow manually": {
      "main": [
        [
          {
            "node": "Validate and process input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
