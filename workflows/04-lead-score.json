{
  "name": "Customer Welcome Email",
  "nodes": [
    {
      "id": "trigger-4",
      "name": "Receive request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "customer-welcome",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "process-4",
      "name": "Validate and prepare data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const name=String(b.name||\"there\").trim();const email=String(b.email||\"\").trim().toLowerCase();return [{json:{name,email,valid:/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email),subject:\"Welcome — thanks for contacting us\",body:\"Hi \"+name+\",\\n\\nThanks for contacting our team. We have received your message and will follow up soon.\\n\\nBest regards,\\nCustomer Success\",receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "gmail-4",
      "name": "Send Gmail notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email || 'YOUR_TEAM_EMAIL@example.com' }}",
        "subject": "={{ $json.subject || $json.emailSubject || 'FlowForge-AI notification' }}",
        "emailType": "text",
        "message": "={{ $json.body || $json.emailBody || $json.alert || $json.reviewText || $json.slackText || JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Receive request": {
      "main": [
        [
          {
            "node": "Validate and prepare data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate and prepare data": {
      "main": [
        [
          {
            "node": "Send Gmail notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-4",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
