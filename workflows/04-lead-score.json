      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const email=String(b.email||\"\").trim().toLowerCase();const budget=Number(b.budget||0);const intent=String(b.intent||\"\").toLowerCase();const company=String(b.company||\"\").trim();const score=(/buy|ready|quote|demo/.test(intent)?40:0)+(budget>=1000?25:budget>0?10:0)+(company?15:0)+(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)?20:0);return [{json:{name:String(b.name||\"\"),email,company,budget:Number.isFinite(budget)?budget:null,intent,leadScore:score,leadTier:score>=70?\"hot\":score>=40?\"warm\":\"cold\",validEmail:/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email),createdAt:new Date().toISOString(),disclaimer:\"Rule-based score; calibrate against your real sales process.\"}}];"
      }
    },
    {
      "id": "respond",
      "name": "Return JSON response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        760,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
