{
  "name": "07 - Meeting Booking Intake and Calendar Prep",
  "nodes": [
    {
      "id": "trigger",
      "name": "Receive Booking Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-booking",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate Booking Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const start=Date.parse(b.start);const end=Date.parse(b.end);const email=String(b.email||'').trim().toLowerCase();const valid=!!String(b.name||'').trim()&&/^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(email)&&Number.isFinite(start)&&Number.isFinite(end)&&end>start&&start>Date.now();return [{json:{name:String(b.name||'').trim(),email,start:b.start||'',end:b.end||'',timezone:b.timezone||'UTC',topic:b.topic||'Discovery call',valid,createdAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Request Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "calendar",
      "name": "Create Calendar Event — Configure Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        960,
        200
      ],
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "REPLACE_WITH_CALENDAR_ID",
          "mode": "id"
        },
        "start": "={{ $json.start }}",
        "end": "={{ $json.end }}",
        "additionalFields": {
          "summary": "={{ $json.topic }}",
          "description": "=Meeting requested by {{ $json.name }} ({{ $json.email }})"
        }
      }
    },
    {
      "id": "success",
      "name": "Return Booking Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1210,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"message\":\"Booking request accepted; verify calendar result.\"}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "bad",
      "name": "Return Invalid Booking",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        960,
        430
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":false,\"message\":\"Check name, email, future start and end time.\"}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Receive Booking Request": {
      "main": [
        [
          {
            "node": "Validate Booking Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Booking Fields": {
      "main": [
        [
          {
            "node": "Request Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Valid?": {
      "main": [
        [
          {
            "node": "Create Calendar Event — Configure Google Calendar",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Invalid Booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Calendar Event — Configure Google Calendar": {
      "main": [
        [
          {
            "node": "Return Booking Accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "ffai-07",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
