{
  "name": "07 - Meeting Booking Intake and Calendar Prep",
  "nodes": [
    {
      "id": "trigger",
      "name": "Receive Booking Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-booking",
        "responseMode": "lastNode",
        "options": {},
        "authentication": "headerAuth"
      }
    },
    {
      "id": "validate",
      "name": "Validate Booking Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json; const start=Date.parse(b.start); const end=Date.parse(b.end); const email=String(b.email||'').trim().toLowerCase(); const requestId=String(b.requestId||b.eventId||'').trim(); const valid=!!requestId&&!!String(b.name||'').trim()&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)&&Number.isFinite(start)&&Number.isFinite(end)&&end>start&&start>Date.now(); return [{json:{requestId,name:String(b.name||'').trim(),email,start:b.start||'',end:b.end||'',timezone:b.timezone||'UTC',topic:b.topic||'Discovery call',valid,createdAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Request Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "calendar",
      "name": "Create Calendar Event — Configure Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        960,
        200
      ],
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "REPLACE_WITH_CALENDAR_ID",
          "mode": "id"
        },
        "start": "={{ $json.start }}",
        "end": "={{ $json.end }}",
        "additionalFields": {
          "summary": "={{ $json.topic }}",
          "description": "=Meeting requested by {{ $json.name }} ({{ $json.email }})"
        }
      }
    },
    {
      "id": "success",
      "name": "Return Booking Accepted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1210,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$json||{}; return [{json:{...d,ok:true,status:String(d.status||'completed'),httpStatus:200,requestId:String(d.requestId||d.eventId||d._flowforge?.requestId||'')}}];"
      }
    },
    {
      "id": "bad",
      "name": "Return Invalid Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        430
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$json||{}; return [{json:{...d,ok:false,status:'rejected',httpStatus:400,requestId:String(d.requestId||d.eventId||d._flowforge?.requestId||''),error:String(d.error||'invalid_input')}}];"
      }
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -600,
        560
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -350,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    }
  ],
  "connections": {
    "Receive Booking Request": {
      "main": [
        [
          {
            "node": "Validate Booking Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Booking Fields": {
      "main": [
        [
          {
            "node": "Request Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Valid?": {
      "main": [
        [
          {
            "node": "Create Calendar Event — Configure Google Calendar",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Invalid Booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Calendar Event — Configure Google Calendar": {
      "main": [
        [
          {
            "node": "Return Booking Accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Called by Parent Workflow": {
      "main": [
        [
          {
            "node": "Normalize Parent Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Parent Payload": {
      "main": [
        [
          {
            "node": "Validate Booking Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "ffai-07",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}