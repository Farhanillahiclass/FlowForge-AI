{
  "name": "13 - YouTube Publishing Assistant",
  "nodes": [
    {
      "id": "trigger",
      "name": "Submit YouTube Metadata",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "youtube-publish-request",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate Metadata and Default Private",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const title=String(b.title||'').trim();const description=String(b.description||'').trim();const tags=Array.isArray(b.tags)?b.tags:[];return [{json:{title,description,tags,videoFileReference:b.videoFileReference||'',valid:title.length>0&&description.length>0,visibility:b.visibility==='public'?'private':(b.visibility||'private'),approvalRequired:true,status:'metadata-ready',submittedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Metadata Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "upload",
      "name": "Human Approval → YouTube Upload Node → Processing Status → Notify Owner",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        200
      ],
      "parameters": {}
    },
    {
      "id": "bad",
      "name": "Return Invalid Metadata",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        960,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\":false,\"message\":\"Title and description are required\"}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Submit YouTube Metadata": {
      "main": [
        [
          {
            "node": "Validate Metadata and Default Private",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Metadata and Default Private": {
      "main": [
        [
          {
            "node": "Metadata Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Metadata Valid?": {
      "main": [
        [
          {
            "node": "Human Approval → YouTube Upload Node → Processing Status → Notify Owner",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Invalid Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-13-youtube-publishing-assistant",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
