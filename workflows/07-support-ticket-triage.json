{
  "name": "Sales Inquiry Router",
  "nodes": [
    {
      "id": "trigger-7",
      "name": "Receive request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "sales-inquiry",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "process-7",
      "name": "Validate and prepare data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const topic=String(b.topic||b.message||\"\").toLowerCase();const department=/pricing|quote|buy|sales/.test(topic)?\"sales\":/bug|error|support|help/.test(topic)?\"support\":/invoice|payment|billing/.test(topic)?\"billing\":\"general\";return [{json:{name:String(b.name||\"\"),email:String(b.email||\"\"),company:String(b.company||\"\"),topic:String(b.topic||\"\"),message:String(b.message||\"\"),department,receivedAt:new Date().toISOString(),slackText:\"New \"+department+\" inquiry from \"+String(b.name||\"unknown\")+\" (\"+String(b.company||\"no company\")+\"): \"+String(b.message||b.topic||\"No details\")}}];"
      }
    },
    {
      "id": "sheets-7",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        300
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "slack-7",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        970,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "YOUR_SLACK_CHANNEL_ID",
        "text": "={{ $json.slackText || $json.alert || JSON.stringify($json) }}",
        "otherOptions": {}
      }
    },
    {
      "id": "gmail-7",
      "name": "Send Gmail notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1220,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email || 'YOUR_TEAM_EMAIL@example.com' }}",
        "subject": "={{ $json.subject || $json.emailSubject || 'FlowForge-AI notification' }}",
        "emailType": "text",
        "message": "={{ $json.body || $json.emailBody || $json.alert || $json.reviewText || $json.slackText || JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Receive request": {
      "main": [
        [
          {
            "node": "Validate and prepare data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate and prepare data": {
      "main": [
        [
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Google Sheets": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Slack": {
      "main": [
        [
          {
            "node": "Send Gmail notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-7",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
