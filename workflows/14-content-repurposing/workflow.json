{
  "name": "14 - Multi-platform Content Repurposing",
  "nodes": [
    {
      "id": "trigger",
      "name": "Submit Source Content",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "content-repurpose",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate Source and Targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json; const sourceText=String(b.sourceText||'').trim(); const requestId=String(b.requestId||b.eventId||'').trim(); return [{json:{requestId,sourceText,targets:Array.isArray(b.targets)?b.targets:['linkedin','instagram','youtube'],tone:b.tone||'professional',editorEmail:String(b.editorEmail||'REPLACE_WITH_EDITOR_EMAIL'),valid:!!requestId&&sourceText.length>=50,approvalRequired:true,status:sourceText.length>=50?'ready-for-drafting':'needs-more-source',submittedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Source Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "llm",
      "name": "Create Platform Drafts with Anthropic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {model:'REPLACE_WITH_SUPPORTED_ANTHROPIC_MODEL',max_tokens:2000,messages:[{role:'user',content:'Repurpose this source into separate concise drafts for these platforms: '+$('Validate Source and Targets').first().json.targets.join(', ')+'. Tone: '+$('Validate Source and Targets').first().json.tone+'. Return clear platform headings. Keep factual claims faithful to the source and do not invent quotes. Source: '+$('Validate Source and Targets').first().json.sourceText}] } }}",
        "options": {
          "response": {
            "responseFormat": "json"
          }
        }
      }
    },
    {
      "id": "approve",
      "name": "Save Drafts and Email for Approval",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1210,
        200
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_CONTENT_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "RepurposedDrafts",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "bad",
      "name": "Return Invalid Source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$json||{}; return [{json:{...d,ok:false,status:'rejected',httpStatus:400,requestId:String(d.requestId||d.eventId||d._flowforge?.requestId||''),error:String(d.error||'invalid_input')}}];"
      }
    },
    {
      "id": "extract-platform-drafts",
      "name": "Extract Repurposed Drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        830,
        180
      ],
      "parameters": {
        "jsCode": "const r=$json||{}; const b=$('Validate Source and Targets').first().json; const drafts=String(r.content?.map(c=>c.text||'').join('\\n')||'').trim(); if(!drafts)throw new Error('Anthropic returned empty content');return [{json:{...b,drafts,status:'pending-human-approval',draftedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "editor-email",
      "name": "Send Repurposed Drafts to Editor",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1080,
        180
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Extract Repurposed Drafts').first().json.editorEmail }}",
        "subject": "Platform-specific content drafts awaiting approval",
        "emailType": "text",
        "message": "=Request ID: {{ $('Extract Repurposed Drafts').first().json.requestId }}\\nTargets: {{ $('Extract Repurposed Drafts').first().json.targets.join(', ') }}\\n\\n{{ $('Extract Repurposed Drafts').first().json.drafts }}\\n\\nTo continue, submit an approved request through the protected workflow with approved=true and the same requestId.",
        "options": {}
      }
    },
    {
      "id": "draft-result",
      "name": "Return Draft Review Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ],
      "parameters": {
        "jsCode": "const e=$('Extract Repurposed Drafts').first().json; return [{json:{ok:true,status:'pending-human-approval',httpStatus:202,requestId:e.requestId,targets:e.targets,drafts:e.drafts,approvalRequired:true}}];"
      }
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -650,
        560
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    }
  ],
  "connections": {
