{
  "name": "05 - Customer Support Ticket Intake",
  "nodes": [
    {
      "id": "wh",
      "name": "Receive Support Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket-intake",
        "responseMode": "lastNode",
        "options": {},
        "authentication": "headerAuth"
      }
    },
    {
      "id": "classify",
      "name": "Validate and Classify Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json; const requestId=String(b.requestId||b.eventId||'').trim(); const message=String(b.message||b.description||'').trim(); const email=String(b.email||'').trim().toLowerCase(); const priority=/urgent|blocked|cannot access|security|outage/i.test(message)?'high':'normal'; const category=/refund|payment|invoice|billing/i.test(message)?'billing':/error|bug|crash|not working|access/i.test(message)?'technical':'general'; const valid=!!requestId&&!!message&&/^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(email); return [{json:{requestId,eventType:String(b.eventType||'support.ticket.created'),ticketId:'SUP-'+requestId,name:String(b.name||'').trim(),email,message,priority,category,status:'processing',valid,createdAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Valid Ticket?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ok",
      "name": "Return Ticket Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$('Validate and Classify Ticket').first().json;return [{json:{ok:true,status:'created',httpStatus:201,requestId:e.requestId,ticketId:e.ticketId,priority:e.priority,category:e.category,notification:'support-alert-attempted'}}];"
      }
    },
    {
      "id": "bad",
      "name": "Return Validation Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$('Validate and Classify Ticket').first().json;return [{json:{ok:false,status:'rejected',httpStatus:422,requestId:e.requestId||'',error:'invalid_support_ticket',message:'requestId, a valid email and ticket message are required'}}];"
      }
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -500,
        520
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    },
    {
      "id": "read-existing",
      "name": "Read Existing Support Tickets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        930,
        220
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SUPPORT_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "SupportTickets",
          "mode": "name"
        },
        "returnAll": true,
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "dedupe",
      "name": "Check Duplicate Request ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const current=$('Validate and Classify Ticket').first().json;const rows=$input.all().map(i=>i.json).filter(r=>r&&Object.keys(r).length);const prior=rows.find(r=>String(r.requestId||'').trim()===current.requestId||String(r.ticketId||'').trim()===current.ticketId);return [{json:{...current,duplicate:!!prior,existingStatus:String(prior?.status||'')}}];"
      }
    },
    {
      "id": "is-duplicate",
      "name": "Ticket Already Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "duplicate",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "save-ticket",
      "name": "Save Support Ticket to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1600,
        320
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SUPPORT_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "SupportTickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "notify-support",
      "name": "Notify Support Team via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1840,
        320
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_SUPPORT_EMAIL",
        "subject": "=[{{ $('Validate and Classify Ticket').first().json.priority.toUpperCase() }}] Support ticket {{ $('Validate and Classify Ticket').first().json.ticketId }}",
        "emailType": "text",
        "message": "=A support ticket was received.\\nRequest ID: {{ $('Validate and Classify Ticket').first().json.requestId }}\\nTicket: {{ $('Validate and Classify Ticket').first().json.ticketId }}\\nName: {{ $('Validate and Classify Ticket').first().json.name }}\\nEmail: {{ $('Validate and Classify Ticket').first().json.email }}\\nPriority: {{ $('Validate and Classify Ticket').first().json.priority }}\\nCategory: {{ $('Validate and Classify Ticket').first().json.category }}\\n\\n{{ $('Validate and Classify Ticket').first().json.message }}",
        "options": {}
      }
    },
    {
      "id": "duplicate-result",
      "name": "Return Duplicate Ticket Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        120
      ],
      "parameters": {
        "jsCode": "const e=$json;return [{json:{ok:true,status:'duplicate',httpStatus:200,requestId:e.requestId,ticketId:e.ticketId,sideEffectsSkipped:true,existingStatus:e.existingStatus}}];"
      }
    }
  ],
  "connections": {
