{
  "name": "20 - Telegram Business Assistant",
  "nodes": [
    {
      "id": "trigger",
      "name": "Receive Bot Update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-business-assistant",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "parse",
      "name": "Parse Commands",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const text=String(b.message?.text||b.text||'').trim();const chatId=b.message?.chat?.id||b.chatId||null;const command=(text.split(/\\\\s+/)[0]||'').toLowerCase();const route=command==='/start'?'welcome':command==='/help'?'help':command==='/lead'?'lead-intake':command==='/support'?'support-ticket':'human-review';return [{json:{chatId,text,command,route,valid:!!text&&!!chatId,receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "switch",
      "name": "Route Bot Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "welcome",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "welcome"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "help",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "help"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "lead-intake",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "lead"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "welcome",
      "name": "Send Welcome Message — Configure Telegram",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        980,
        160
      ],
      "parameters": {}
    },
    {
      "id": "help",
      "name": "Send Help Menu — Configure Telegram",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        980,
        280
      ],
      "parameters": {}
    },
    {
      "id": "lead",
      "name": "Create Lead Record — Configure Sheets and Reply",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        980,
        400
      ],
      "parameters": {}
    },
    {
      "id": "fallback",
      "name": "Support Ticket / Human Handoff — Configure Telegram + CRM",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        980,
        520
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Receive Bot Update": {
      "main": [
        [
          {
            "node": "Parse Commands",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Commands": {
      "main": [
        [
          {
            "node": "Route Bot Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Bot Command": {
      "main": [
        [
          {
            "node": "Send Welcome Message — Configure Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Help Menu — Configure Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create Lead Record — Configure Sheets and Reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Support Ticket / Human Handoff — Configure Telegram + CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-20-telegram-business-assistant",
