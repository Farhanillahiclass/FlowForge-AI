{
  "name": "13 — Data Quality Gate",
  "nodes": [
    {
      "id": "manual",
      "name": "Run workflow manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {}
    },
    {
      "id": "process",
      "name": "Validate and process input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(i=>{const r=i.json;const issues=[];if(!String(r.name||\"\").trim())issues.push(\"missing_name\");if(!String(r.email||\"\").trim())issues.push(\"missing_email\");else if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(r.email).trim()))issues.push(\"invalid_email\");if(r.amount!==undefined&&(!Number.isFinite(Number(r.amount))||Number(r.amount)<0))issues.push(\"invalid_amount\");return {json:{...r,isValid:issues.length===0,qualityStatus:issues.length?\"needs_review\":\"passed\",issues,checkedAt:new Date().toISOString()}}});"
      }
    }
  ],
  "connections": {
    "Run workflow manually": {
      "main": [
        [
          {
            "node": "Validate and process input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-13",
