{
  "name": "03 - Email Follow-up Queue",
  "nodes": [
    {
      "id": "schedule",
      "name": "Run Follow-up Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      }
    },
    {
      "id": "prepare",
      "name": "Prepare Safe Follow-up Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{checkedAt:new Date().toISOString(),status:'setup-required',requiredSteps:['Connect a CRM or Google Sheets read node','Filter contacts whose follow-up is due','Exclude unsubscribed or opted-out contacts','Send via Gmail','Update lastSentAt and nextFollowUpAt','Deduplicate using a stable contact/campaign key'],productionReady:false}}];"
      }
    },
    {
      "id": "end",
      "name": "Review Setup Status",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        700,
        300
      ],
      "parameters": {}
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -500,
        520
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    }
  ],
