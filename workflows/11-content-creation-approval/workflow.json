{
  "name": "11 - Content Creation and Approval Pipeline",
  "nodes": [
    {
      "id": "trigger",
      "name": "Submit Content Brief",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "content-brief",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate Brief and Set Approval Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const brief=String(b.brief||'').trim();return [{json:{brief,platforms:Array.isArray(b.platforms)?b.platforms:['linkedin'],tone:b.tone||'professional',audience:b.audience||'general',valid:brief.length>=20,status:brief.length>=20?'draft-required':'needs-better-brief',humanApprovalRequired:true,submittedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Brief Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "generate",
      "name": "Connect LLM Node to Generate Draft",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        950,
        200
      ],
      "parameters": {}
    },
    {
      "id": "approve",
      "name": "Store Draft and Request Human Approval via Slack/Telegram",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1200,
        200
      ],
      "parameters": {}
    },
    {
      "id": "bad",
      "name": "Reject Short Brief",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        950,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\":false,\"message\":\"Please provide a more detailed brief\"}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Submit Content Brief": {
      "main": [
        [
          {
            "node": "Validate Brief and Set Approval Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Brief and Set Approval Gate": {
      "main": [
        [
          {
            "node": "Brief Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Brief Valid?": {
      "main": [
        [
          {
            "node": "Connect LLM Node to Generate Draft",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Short Brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Connect LLM Node to Generate Draft": {
      "main": [
        [
          {
            "node": "Store Draft and Request Human Approval via Slack/Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-11-content-creation-and-approval-pipeline",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
