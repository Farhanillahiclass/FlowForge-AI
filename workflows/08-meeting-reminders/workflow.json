{
  "name": "08 - Meeting Reminder Dispatcher",
  "nodes": [
    {
      "id": "schedule",
      "name": "Check Reminder Window",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "calendar",
      "name": "Get Upcoming Events — Configure Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        450,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "REPLACE_WITH_CALENDAR_ID",
          "mode": "id"
        },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "filter",
      "name": "Filter Events Requiring Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now=Date.now();return $input.all().filter(i=>{const e=i.json;const start=Date.parse(e.start?.dateTime||e.start||'');const minutes=(start-now)/60000;return Number.isFinite(start)&&minutes>=0&&minutes<=60&&(e.attendees||[]).some(a=>a.email);}).map(i=>({json:{...i.json,reminderDue:true,reminderWindowMinutes:60,reminderRecipient:String((i.json.attendees||[]).find(a=>a.email)?.email||i.json.organizer?.email||''),reminderKey:String(i.json.id||i.json.iCalUID||'')+':60m'}}));"
      }
    },
    {
      "id": "notify",
      "name": "Send Meeting Reminder via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        980,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.reminderRecipient }}",
        "subject": "Meeting reminder: {{ $json.summary || 'Upcoming meeting' }}",
        "emailType": "text",
        "message": "=Reminder: your meeting is scheduled to start within the next 60 minutes.\\nMeeting: {{ $json.summary || 'Meeting' }}\\nStart: {{ $json.start.dateTime || $json.start }}\\nPlease check the calendar event for details.",
        "options": {}
      }
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -600,
        560
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -350,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    },
    {
      "id": "read-reminder-log",
      "name": "Read Sent Reminder Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        900,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_REMINDER_LOG_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ReminderLog",
          "mode": "name"
        },
        "returnAll": true,
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "dedupe-reminders",
      "name": "Exclude Already Sent Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const events=$('Filter Events Requiring Reminder').all().map(i=>i.json);const logged=$input.all().map(i=>i.json).filter(r=>r&&Object.keys(r).length);const pending=events.filter(e=>!logged.some(r=>String(r.reminderKey||'')===String(e.reminderKey||'')));return pending.map(e=>({json:e}));"
      }
    },
    {
      "id": "append-reminder-log",
      "name": "Record Reminder Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1600,
        280
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_REMINDER_LOG_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ReminderLog",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "reminderKey": "={{ $json.reminderKey }}",
            "eventId": "={{ $json.id || $json.iCalUID || '' }}",
            "recipient": "={{ $json.reminderRecipient }}",
            "summary": "={{ $json.summary || '' }}",
            "sentAt": "={{ new Date().toISOString() }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "reminder-result",
      "name": "Return Reminder Send Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1830,
        280
      ],
      "parameters": {
        "jsCode": "const e=$json;return [{json:{ok:true,status:'reminder-sent',eventId:e.id||e.iCalUID||'',reminderKey:e.reminderKey,recipient:e.reminderRecipient,logged:true}}];"
      }
    }
  ],
  "connections": {
    "Check Reminder Window": {
      "main": [
        [
          {
            "node": "Get Upcoming Events — Configure Google Calendar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Upcoming Events — Configure Google Calendar": {
      "main": [
        [
          {
            "node": "Filter Events Requiring Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Events Requiring Reminder": {
      "main": [
        [
          {
            "node": "Read Sent Reminder Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Called by Parent Workflow": {
      "main": [
        [
          {
            "node": "Normalize Parent Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Parent Payload": {
      "main": [
        [
          {
            "node": "Get Upcoming Events — Configure Google Calendar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Sent Reminder Log": {
      "main": [
        [
          {
            "node": "Exclude Already Sent Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Exclude Already Sent Reminders": {
      "main": [
        [
          {
            "node": "Send Meeting Reminder via Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Meeting Reminder via Gmail": {
      "main": [
        [
          {
            "node": "Record Reminder Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Reminder Sent": {
      "main": [
        [
          {
            "node": "Return Reminder Send Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-08-meeting-reminder-dispatcher",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
