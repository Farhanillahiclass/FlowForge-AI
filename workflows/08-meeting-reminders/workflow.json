{
  "name": "08 - Meeting Reminder Dispatcher",
  "nodes": [
    {
      "id": "schedule",
      "name": "Check Reminder Window",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      }
    },
    {
      "id": "calendar",
      "name": "Get Upcoming Events — Configure Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        450,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "REPLACE_WITH_CALENDAR_ID",
          "mode": "id"
        },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "filter",
      "name": "Filter Events Requiring Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now=Date.now();return $input.all().filter(i=>{const start=Date.parse(i.json.start?.dateTime||i.json.start||'');const minutes=(start-now)/60000;return Number.isFinite(start)&&minutes>=0&&minutes<=60;}).map(i=>({json:{...i.json,reminderDue:true,reminderWindowMinutes:60}}));"
      }
    },
    {
      "id": "notify",
      "name": "Send Reminder — Add Gmail or Telegram Node",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        980,
        300
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Check Reminder Window": {
      "main": [
        [
          {
            "node": "Get Upcoming Events — Configure Google Calendar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Upcoming Events — Configure Google Calendar": {
      "main": [
        [
          {
            "node": "Filter Events Requiring Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Events Requiring Reminder": {
      "main": [
        [
          {
            "node": "Send Reminder — Add Gmail or Telegram Node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-08-meeting-reminder-dispatcher",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
