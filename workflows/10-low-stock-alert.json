{
  "name": "10 — Inventory Reorder Monitor",
  "nodes": [
    {
      "id": "manual",
      "name": "Run workflow manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {}
    },
    {
      "id": "process",
      "name": "Validate and process input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(i=>{const r=i.json;const stock=Number(r.stock);const threshold=Number(r.reorderPoint??5);const valid=Number.isFinite(stock)&&stock>=0&&Number.isFinite(threshold)&&threshold>=0;const status=!valid?\"invalid-data\":stock===0?\"out-of-stock\":stock<=threshold?\"reorder\":\"in-stock\";return {json:{...r,stock,threshold,valid,status,needsRestock:valid&&stock<=threshold,recommendedOrderQty:valid&&stock<=threshold?Math.max(0,Number(r.targetStock??threshold*3)-stock):0,checkedAt:new Date().toISOString()}}});"
      }
    }
  ],
  "connections": {
    "Run workflow manually": {
      "main": [
        [
          {
            "node": "Validate and process input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-10",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
