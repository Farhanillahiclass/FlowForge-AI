{
  "name": "Calendar Booking Request",
  "nodes": [
    {
      "id": "trigger-5",
      "name": "Receive request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-request",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "process-5",
      "name": "Validate and prepare data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json;const start=String(b.start||\"\");const end=String(b.end||\"\");const valid=!!b.name&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(b.email||\"\"))&&Number.isFinite(Date.parse(start))&&Number.isFinite(Date.parse(end))&&Date.parse(end)>Date.parse(start);return [{json:{name:String(b.name||\"\"),email:String(b.email||\"\"),start,end,topic:String(b.topic||\"Meeting\"),valid,summary:\"Meeting with \"+String(b.name||\"Guest\")+\" — \"+String(b.topic||\"General\"),description:\"Requested by \"+String(b.name||\"\")+\" (\"+String(b.email||\"\")+\")\",receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "calendar-5",
      "name": "Create Google Calendar event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        720,
        300
      ],
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "Primary Calendar"
        },
        "start": "={{ $json.start }}",
        "end": "={{ $json.end }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "={{ $json.calendarSummary || $json.summary || 'Business meeting' }}",
          "description": "={{ $json.calendarDescription || $json.description || '' }}"
        }
      }
    },
    {
      "id": "gmail-5",
      "name": "Send Gmail notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        970,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email || 'YOUR_TEAM_EMAIL@example.com' }}",
        "subject": "={{ $json.subject || $json.emailSubject || 'FlowForge-AI notification' }}",
        "emailType": "text",
        "message": "={{ $json.body || $json.emailBody || $json.alert || $json.reviewText || $json.slackText || JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Receive request": {
      "main": [
        [
          {
            "node": "Validate and prepare data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate and prepare data": {
      "main": [
        [
          {
            "node": "Create Google Calendar event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Google Calendar event": {
      "main": [
        [
          {
            "node": "Send Gmail notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "flowforge-pro-5",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
