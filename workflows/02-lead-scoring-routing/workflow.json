      "position": [
        930,
        430
      ],
      "parameters": {
        "jsCode": "const e=$('Validate and Score Lead').first().json;return [{json:{ok:false,status:'rejected',httpStatus:422,requestId:e.requestId||'',error:'invalid_lead',message:'requestId, name, valid email and nonnegative budget are required'}}];"
      }
    }
  ],
