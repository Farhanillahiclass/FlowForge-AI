      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SCORE_LOG_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "LeadScores",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "hot-if",
      "name": "Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1170,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "hot",
              "leftValue": "={{ $('Validate and Score Lead').first().json.tier }}",
              "rightValue": "hot",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sales-alert",
      "name": "Notify Sales for Hot Lead",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1410,
        130
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_SALES_PRIORITY_EMAIL",
        "subject": "Hot lead: {{ $('Validate and Score Lead').first().json.name }}",
        "emailType": "text",
        "message": "=Hot lead scored {{ $('Validate and Score Lead').first().json.score }}/100.\\nRequest ID: {{ $('Validate and Score Lead').first().json.requestId }}\\nName: {{ $('Validate and Score Lead').first().json.name }}\\nEmail: {{ $('Validate and Score Lead').first().json.email }}\\nCompany: {{ $('Validate and Score Lead').first().json.company }}",
        "options": {}
      }
    },
    {
      "id": "invalid-result",
