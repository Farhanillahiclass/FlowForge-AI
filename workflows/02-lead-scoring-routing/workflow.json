{
  "name": "02 - Lead Scoring and Routing",
  "nodes": [
    {
      "id": "wh",
      "name": "Receive Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-score-routing",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "code",
      "name": "Score Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json; const budget=Number(b.budget||0); const score=(b.company?15:0)+(budget>=5000?35:budget>=1000?20:0)+(b.timeline==='urgent'?30:10); return [{json:{name:b.name||'',email:String(b.email||'').toLowerCase(),company:b.company||'',score,tier:score>=65?'hot':score>=40?'warm':'cold',createdAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "reply",
      "name": "Return Lead Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$json||{}; return [{json:{...d,ok:true,status:String(d.status||'completed'),httpStatus:200,requestId:String(d.requestId||d.eventId||d._flowforge?.requestId||'')}}];"
      }
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -500,
        520
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    }
  ],
  "connections": {
    "Receive Lead": {
      "main": [
        [
          {
            "node": "Score Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score Lead": {
      "main": [
        [
          {
            "node": "Return Lead Score",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Called by Parent Workflow": {
      "main": [
        [
          {
            "node": "Normalize Parent Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Parent Payload": {
      "main": [
        [
          {
            "node": "Score Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
