{
  "name": "01 - Lead Capture and CRM Intake",
  "nodes": [
    {
      "id": "webhook",
      "name": "Receive Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture-crm",
        "responseMode": "lastNode",
        "options": {},
        "authentication": "headerAuth"
      }
    },
    {
      "id": "normalize",
      "name": "Validate and Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||$json; const name=String(b.name||'').trim(); const email=String(b.email||'').trim().toLowerCase(); const requestId=String(b.requestId||b.eventId||'').trim(); const valid=!!requestId&&!!name&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email); return [{json:{requestId,eventType:String(b.eventType||'lead.created'),name,email,company:String(b.company||'').trim(),source:String(b.source||'website'),message:String(b.message||'').trim(),valid,status:'new',receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "if",
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sheets",
      "name": "Save Lead to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1430,
        220
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "alwaysOutputData": false
    },
    {
      "id": "gmail",
      "name": "Notify Sales via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1660,
        220
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_SALES_EMAIL",
        "subject": "New lead received",
        "emailType": "text",
        "message": "=New lead received. Request ID: {{ $('Validate and Normalize').first().json.requestId }}; Name: {{ $('Validate and Normalize').first().json.name }}; Email: {{ $('Validate and Normalize').first().json.email }}; Company: {{ $('Validate and Normalize').first().json.company }}",
        "options": {}
      }
    },
    {
      "id": "success",
      "name": "Return Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1450,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$('Validate and Normalize').first().json; return [{json:{ok:true,status:'accepted',httpStatus:200,requestId:e.requestId,lead:{name:e.name,email:e.email,company:e.company,source:e.source},notification:'sent-attempted',receivedAt:e.receivedAt}}];"
      }
    },
    {
      "id": "invalid",
      "name": "Return Validation Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        430
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$('Validate and Normalize').first().json; return [{json:{ok:false,status:'rejected',httpStatus:422,requestId:e.requestId||'',error:'invalid_lead',message:'requestId, name and valid email are required'}}];"
      }
    },
    {
      "id": "subflow-trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -500,
        520
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "subflow-adapter",
      "name": "Normalize Parent Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json||{}; const d=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const requestId=String(e.requestId||e.eventId||''); return [{json:{...d,requestId,eventId:requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow'),occurredAt:String(e.occurredAt||new Date().toISOString()),_flowforge:{requestId,eventType:String(e.eventType||''),source:String(e.source||'parent-workflow')}}}];"
      }
    },
    {
      "id": "read-existing",
      "name": "Read Existing Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        950,
        220
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "returnAll": true,
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "dedupe",
      "name": "Check Request ID or Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const current=$('Validate and Normalize').first().json;const rows=$input.all().map(i=>i.json).filter(r=>r&&Object.keys(r).length);const prior=rows.find(r=>(current.requestId&&String(r.requestId||'').trim()===current.requestId)||(current.email&&String(r.email||'').trim().toLowerCase()===current.email));return [{json:{...current,duplicate:!!prior,existingRequestId:String(prior?.requestId||''),existingEmail:String(prior?.email||'')}}];"
      }
    },
    {
      "id": "is-duplicate",
      "name": "Existing Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "duplicate",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "duplicate-result",
      "name": "Return Duplicate Lead Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1630,
        410
      ],
      "parameters": {
        "jsCode": "const e=$json;return [{json:{ok:true,status:'duplicate',httpStatus:200,requestId:e.requestId,lead:{name:e.name,email:e.email},sideEffectsSkipped:true,existingRequestId:e.existingRequestId}}];"
      }
    }
  ],
