{
  "name": "11 - Lead Scoring Sub-workflow",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-lead-score-subflow-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "nodes": [
    {
      "id": "trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "score",
      "name": "Score and Classify Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json; const b=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const email=String(b.email||'').trim().toLowerCase(); const company=String(b.company||'').trim(); const budget=Number(b.budget||0); const need=String(b.businessNeed||b.message||'').trim().length>0; const valid=!!String(e.requestId||'').trim()&&/^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(email); const total=Math.min(100,(email?20:0)+(company?20:0)+(budget>=1000?30:budget>0?10:0)+(need?20:0)+(b.decisionMaker===true?10:0)); const tier=total>=70?'hot':total>=40?'warm':'cold'; return [{json:{requestId:String(e.requestId||'').trim(),eventType:String(e.eventType||''),source:String(e.source||'unknown'),email,name:String(b.name||''),company,budget,businessNeed:String(b.businessNeed||b.message||''),valid,score:total,tier,routedQueue:tier==='hot'?'sales-priority':tier==='warm'?'sales-nurture':'marketing-nurture',scoredAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "valid",
      "name": "Lead Data Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "log",
      "name": "Log Lead Score",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        940,
        200
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SCORE_LOG_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "LeadScores",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "hot",
      "name": "Is Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1190,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $('Score and Classify Lead').first().json.tier === 'hot' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "notify",
      "name": "Alert Sales on Hot Lead",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1440,
        100
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_SALES_PRIORITY_EMAIL",
        "subject": "Hot lead: {{ $('Score and Classify Lead').first().json.name }}",
        "emailType": "text",
        "message": "=Hot lead scored {{ $('Score and Classify Lead').first().json.score }}/100. Email: {{ $('Score and Classify Lead').first().json.email }}; Company: {{ $('Score and Classify Lead').first().json.company }}; Request ID: {{ $('Score and Classify Lead').first().json.requestId }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "hot-result",
      "name": "Return Hot Lead Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        100
      ],
      "parameters": {
        "jsCode": "const e=$('Score and Classify Lead').first().json; return [{json:{ok:true,status:'scored',httpStatus:200,requestId:e.requestId,score:e.score,tier:e.tier,routedQueue:e.routedQueue,notification:'sales-priority-attempted'}}];"
      }
    },
    {
      "id": "other-result",
      "name": "Return Routed Lead Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        280
      ],
      "parameters": {
        "jsCode": "const e=$('Score and Classify Lead').first().json; return [{json:{ok:true,status:'scored',httpStatus:200,requestId:e.requestId,score:e.score,tier:e.tier,routedQueue:e.routedQueue,notification:'not-required-for-this-tier'}}];"
      }
    },
    {
      "id": "rejected",
      "name": "Return Invalid Score Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        440
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:false,status:'rejected',httpStatus:422,error:'invalid_lead_for_scoring',requestId:$json.requestId||'',message:'A stable requestId and valid email are required'}}];"
      }
    }
  ],
  "connections": {
    "Called by Parent Workflow": {
      "main": [
        [
          {
            "node": "Score and Classify Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score and Classify Lead": {
      "main": [
        [
          {
            "node": "Lead Data Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lead Data Valid?": {
      "main": [
        [
          {
            "node": "Log Lead Score",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Invalid Score Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Lead Score": {
      "main": [
        [
          {
            "node": "Is Hot Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Hot Lead?": {
      "main": [
        [
          {
            "node": "Alert Sales on Hot Lead",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Routed Lead Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Sales on Hot Lead": {
      "main": [
        [
          {
            "node": "Return Hot Lead Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
