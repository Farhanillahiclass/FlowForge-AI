{
  "name": "10 - Lead Capture Sub-workflow",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-lead-capture-subflow-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "nodes": [
    {
      "id": "trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "normalize",
      "name": "Normalize and Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json; const b=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const name=String(b.name||'').trim(); const email=String(b.email||'').trim().toLowerCase(); const requestId=String(e.requestId||'').trim(); const valid=!!requestId&&!!name&&/^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(email); return [{json:{requestId,eventType:String(e.eventType||'lead.created'),source:String(e.source||b.source||'unknown'),occurredAt:String(e.occurredAt||new Date().toISOString()),name,email,company:String(b.company||'').trim(),message:String(b.message||'').trim(),receivedAt:new Date().toISOString(),status:'processing',valid}}];"
      }
    },
    {
      "id": "valid",
      "name": "Lead Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "read",
      "name": "Read Existing Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        930,
        200
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_LEADS_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {
          "returnAll": true
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "dedupe",
      "name": "Check Request ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1170,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const original=$('Normalize and Validate Lead').first().json; const rows=$input.all().map(i=>i.json); const prior=rows.find(r=>String(r.requestId||'').trim()===original.requestId); return [{json:{...original,duplicate:!!prior,previousStatus:String(prior?.status||''),reconcileRequired:!!prior&&String(prior.status||'')==='processing'}}];"
      }
    },
    {
      "id": "duplicate",
      "name": "Already Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1410,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "append",
      "name": "Save Processing Record",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1640,
        320
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_LEADS_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "notify",
      "name": "Notify Sales",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1880,
        320
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_SALES_EMAIL",
        "subject": "New lead received",
        "emailType": "text",
        "message": "=New lead received. Name: {{ $('Normalize and Validate Lead').first().json.name }}; Email: {{ $('Normalize and Validate Lead').first().json.email }}; Company: {{ $('Normalize and Validate Lead').first().json.company }}; Request ID: {{ $('Normalize and Validate Lead').first().json.requestId }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "buildsent",
      "name": "Build Sent Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2110,
        320
      ],
      "parameters": {
        "jsCode": "const e=$('Normalize and Validate Lead').first().json; return [{json:{...e,status:'sent'}}];"
      }
    },
    {
      "id": "update",
      "name": "Mark Lead Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2340,
        320
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_LEADS_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "requestId"
          ],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "accepted",
      "name": "Return Accepted Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2580,
        320
      ],
      "parameters": {
        "jsCode": "const e=$('Normalize and Validate Lead').first().json; return [{json:{ok:true,status:'accepted',httpStatus:200,requestId:e.requestId,lead:{name:e.name,email:e.email,company:e.company},notification:'sent'}}];"
      }
    },
    {
      "id": "duplicate-result",
      "name": "Return Duplicate Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        100
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:true,status:'duplicate',httpStatus:200,requestId:$json.requestId,sideEffectsSkipped:true,previousStatus:$json.previousStatus,reconcileRequired:$json.reconcileRequired}}];"
      }
    },
    {
      "id": "rejected",
      "name": "Return Invalid Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        930,
        450
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:false,status:'rejected',httpStatus:422,error:'invalid_lead',requestId:$json.requestId||'',message:'A name, valid email, and stable requestId are required'}}];"
      }
    }
  ],
