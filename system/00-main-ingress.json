{
  "name": "00 - Main Ingress",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-system-ingress-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "nodes": [
    {
      "id": "webhook",
      "name": "Receive Authenticated Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "flowforge-a-z",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate Request Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body&&typeof $json.body==='object'?$json.body:$json; const requestId=String(b.requestId||b.eventId||'').trim(); const eventType=String(b.eventType||'').trim(); const data=b.data&&typeof b.data==='object'&&!Array.isArray(b.data)?b.data:null; const valid=!!requestId&&!!eventType&&data!==null; return [{json:{requestId,eventType,source:String(b.source||'unknown'),occurredAt:String(b.occurredAt||new Date().toISOString()),data,valid,httpStatus:valid?200:422,error:valid?'':'invalid_event_envelope'}}];"
      }
    },
    {
      "id": "ifvalid",
      "name": "Envelope Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "callprocessor",
      "name": "Run Request Processor",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        950,
        220
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_PROCESSOR_WORKFLOW_ID",
          "mode": "list",
          "cachedResultName": "01 - Request Processor"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "requestId": "={{ $json.requestId }}",
            "eventType": "={{ $json.eventType }}",
            "source": "={{ $json.source }}",
            "occurredAt": "={{ $json.occurredAt }}",
            "data": "={{ $json.data }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "invalidresponse",
      "name": "Return Validation Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        950,
        430
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:false,error:$json.error,requestId:$json.requestId,message:'requestId, eventType and object data are required'} }}",
        "options": {
          "responseCode": 422
        }
      }
    },
    {
      "id": "successresponse",
      "name": "Return Processor Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1200,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.httpStatus || ($json.ok === false ? 422 : 200) }}"
        }
      }
    }
  ],
  "connections": {
    "Receive Authenticated Event": {
      "main": [
        [
          {
            "node": "Validate Request Envelope",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Request Envelope": {
      "main": [
        [
          {
            "node": "Envelope Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envelope Valid?": {
      "main": [
        [
          {
            "node": "Run Request Processor",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Validation Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Request Processor": {
      "main": [
        [
          {
            "node": "Return Processor Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
