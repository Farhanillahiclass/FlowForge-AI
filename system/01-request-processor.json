      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "routecode",
      "name": "Validate and Route Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json; const requestId=String(e.requestId||'').trim(); const eventType=String(e.eventType||'').trim(); const data=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:null; const routes={\"lead.created\":\"lead-capture-crm\",\"lead.score_requested\":\"lead-scoring-routing\",\"email.followup.dispatch\":\"email-follow-up-sequence\",\"inbox.message.received\":\"inbox-triage-assistant\",\"support.ticket.created\":\"customer-support-desk\",\"support.faq.question\":\"faq-human-handoff\",\"meeting.booking.requested\":\"meeting-booking-system\",\"meeting.reminder.dispatch\":\"meeting-reminders\",\"client.onboarding.start\":\"client-onboarding\",\"invoice.reminder.dispatch\":\"invoice-payment-reminders\",\"content.draft.requested\":\"content-creation-approval\",\"instagram.publish.requested\":\"instagram-publishing-pipeline\",\"youtube.upload.requested\":\"youtube-publishing-assistant\",\"content.repurpose.requested\":\"content-repurposing\",\"newsletter.campaign.requested\":\"newsletter-campaign-builder\",\"business.report.generate\":\"weekly-business-report\",\"feedback.received\":\"feedback-routing\",\"workflow.error.received\":\"workflow-error-monitor\",\"api.health.check\":\"api-health-monitor\",\"telegram.command.received\":\"telegram-business-assistant\"}; const valid=!!requestId&&!!eventType&&data!==null; return [{json:{...e,requestId,eventType,data,valid,route:routes[eventType]||'unsupported',httpStatus:valid?200:422}}];"
      }
    },
    {
      "id": "validif",
      "name": "Input Contract Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "invalidcontract",
      "name": "Return Invalid Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        520
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:false,status:'rejected',httpStatus:422,error:'invalid_event_envelope',requestId:$json.requestId||'',message:'requestId, eventType and object data are required'}}];"
      }
    },
    {
      "id": "unsupported",
      "name": "Return Unsupported Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1650,
        590
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:false,status:'rejected',httpStatus:422,error:'unsupported_event_type',requestId:$json.requestId,supportedEventTypes:['lead.created','lead.score_requested','support.ticket.created']}}];"
      }
    },
