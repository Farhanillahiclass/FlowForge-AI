{
  "name": "12 - Support Ticket Sub-workflow",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "versionId": "ffai-support-subflow-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [],
  "nodes": [
    {
      "id": "trigger",
      "name": "Called by Parent Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "requestId",
              "type": "string"
            },
            {
              "name": "eventType",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            },
            {
              "name": "occurredAt",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "normalize",
      "name": "Normalize Support Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$json; const b=e.data&&typeof e.data==='object'&&!Array.isArray(e.data)?e.data:{}; const subject=String(b.subject||'').trim(); const description=String(b.description||b.message||'').trim(); const requestId=String(e.requestId||'').trim(); const valid=!!requestId&&!!subject&&!!description; const text=(subject+' '+description).toLowerCase(); const priority=/security|urgent|outage|cannot access|payment failed|data loss/.test(text)?'high':/billing|refund|login|error/.test(text)?'normal':'low'; return [{json:{requestId,eventType:String(e.eventType||'support.ticket.created'),source:String(e.source||'unknown'),occurredAt:String(e.occurredAt||new Date().toISOString()),subject,description,email:String(b.email||'').trim().toLowerCase(),customerName:String(b.name||''),category:String(b.category||'general'),priority,valid,status:'processing',receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "valid",
      "name": "Ticket Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "read",
      "name": "Read Existing Tickets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        920,
        200
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SUPPORT_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "SupportTickets",
          "mode": "name"
        },
        "options": {
          "returnAll": true
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "dedupe",
      "name": "Check Ticket Request ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const original=$('Normalize Support Ticket').first().json; const rows=$input.all().map(i=>i.json); const prior=rows.find(r=>String(r.requestId||'').trim()===original.requestId); return [{json:{...original,duplicate:!!prior,previousStatus:String(prior?.status||''),reconcileRequired:!!prior&&String(prior.status||'')==='processing'}}];"
      }
    },
    {
      "id": "duplicate",
      "name": "Ticket Already Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1400,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "append",
      "name": "Save Processing Ticket",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1630,
        320
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SUPPORT_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "SupportTickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "notify",
      "name": "Notify Support Team",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1870,
        320
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_SUPPORT_EMAIL",
        "subject": "=[{{ $('Normalize Support Ticket').first().json.priority.toUpperCase() }}] {{ $('Normalize Support Ticket').first().json.subject }}",
        "emailType": "text",
        "message": "=Request ID: {{ $('Normalize Support Ticket').first().json.requestId }}\\nPriority: {{ $('Normalize Support Ticket').first().json.priority }}\\nCustomer: {{ $('Normalize Support Ticket').first().json.customerName }}\\nEmail: {{ $('Normalize Support Ticket').first().json.email }}\\nDescription: {{ $('Normalize Support Ticket').first().json.description }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "build-notified",
      "name": "Build Notified Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        320
      ],
      "parameters": {
        "jsCode": "const e=$('Normalize Support Ticket').first().json; return [{json:{...e,status:'notified'}}];"
      }
    },
    {
      "id": "update",
      "name": "Mark Ticket Notified",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2330,
        320
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SUPPORT_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "SupportTickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "requestId"
          ],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "created",
      "name": "Return Created Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        320
      ],
      "parameters": {
        "jsCode": "const e=$('Normalize Support Ticket').first().json; return [{json:{ok:true,status:'created',httpStatus:200,requestId:e.requestId,ticket:{subject:e.subject,priority:e.priority,category:e.category},notification:'sent'}}];"
      }
    },
    {
      "id": "duplicate-result",
      "name": "Return Duplicate Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1630,
        100
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:true,status:'duplicate',httpStatus:200,requestId:$json.requestId,sideEffectsSkipped:true,previousStatus:$json.previousStatus,reconcileRequired:$json.reconcileRequired}}];"
      }
    },
    {
      "id": "rejected",
      "name": "Return Invalid Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        450
      ],
      "parameters": {
        "jsCode": "return [{json:{ok:false,status:'rejected',httpStatus:422,error:'invalid_support_ticket',requestId:$json.requestId||'',message:'A stable requestId, subject and description are required'}}];"
      }
    }
  ],
